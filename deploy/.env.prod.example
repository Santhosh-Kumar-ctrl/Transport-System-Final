# Production settings. Copy to deploy/.env (never commit it) and replace every CHANGE-ME.
# The API refuses to start with a weak JWT_SECRET, ALLOW_SIMULATION=true or CORS_ORIGINS=*.

# Public names, both pointing at this VM (DNS A/AAAA records).
WEB_DOMAIN=transit.example.edu
API_DOMAIN=api.transit.example.edu

# Database password. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE-ME

# Signs every login token. Generate one with: openssl rand -hex 32
JWT_SECRET=CHANGE-ME
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
ALLOW_SIMULATION=false

TIMEZONE=Asia/Kolkata
QR_TTL_SECONDS=30
DELAY_THRESHOLD_MIN=5
DELAY_ALERT_STEPS=5,15,30,60
DELAY_STUDENT_ALERT_MAX_MIN=30
CAPACITY_WARN_PCT=90

LOGIN_ATTEMPTS_PER_MINUTE=10
REPORTS_PER_HOUR=5
POSITION_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=180

# Report agent. "rules" works without a model. To use the local model, start the stack with
# --profile ai, pull the models once (docs/DEPLOY.md) and set REPORT_AI=ollama.
REPORT_AI=rules
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
